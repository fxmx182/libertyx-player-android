<?xml version="1.0" encoding="utf-8"?>
<!-- A bolinha: grande o bastante para o polegar achar sem mirar, com borda
     branca para se separar de um quadro também dourado. Cresce enquanto o
     dedo arrasta, para se ver por baixo dele, e quando a barra está focada
     na TV — "as setas agora mexem aqui" lido da poltrona. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/libertyx_accent" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
            <size android:width="32dp" android:height="32dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/libertyx_accent" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
            <size android:width="30dp" android:height="30dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/libertyx_accent" />
            <stroke android:width="2.5dp" android:color="#FFFFFFFF" />
            <size android:width="24dp" android:height="24dp" />
        </shape>
    </item>
</selector>
